# nx 25.0.0 is a local release served by `pnpm local-registry` in the nx repo.
# The URL is an ngrok tunnel to it, so CI runners and agents can reach it.
registry=https://707ea6dfcf96.ngrok.app
# package-lock.json records the registry it was written against; install from
# the registry above whatever host the lockfile names.
replace-registry-host=always
